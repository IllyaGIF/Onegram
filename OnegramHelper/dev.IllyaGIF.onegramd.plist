<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.IllyaGIF.onegramd</string>
    <key>Program</key>
    <string>/usr/local/bin/onegramd</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/onegramd</string>
    </array>
    <key>UserName</key>
    <string>mobile</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardErrorPath</key>
    <string>/var/mobile/Library/Logs/onegramd.stderr.log</string>
</dict>
</plist>
